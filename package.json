    "demo": "node tools/serve-demo.mjs"
  },
  "dependencies": {
    "@nadohq/engine-client": "0.65.0",
    "@nadohq/shared": "0.65.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  },
  "overrides": {
    "axios": "1.21.1",
    "ws": "8.23.0"
  }
}
