{
  "name": "whenx-nado-builder-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only NADO integration examples and WHENX product showcase",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
